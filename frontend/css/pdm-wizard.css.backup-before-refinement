/* =========================================
   PDM MULTI-STEP FORM
========================================= */

.pdm-layout {
    display: block !important;
    width: 100%;
}

.pdm-form-card {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
}

.pdm-step[hidden] {
    display: none !important;
}

.pdm-stepper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    margin: 0 auto 30px;
    padding: 24px;
    background: #fff;
    border: 1px solid #e5eaf2;
    border-radius: 16px;
}

.pdm-step-indicator {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    opacity: .5;
    transition: opacity .2s ease;
}

.pdm-step-indicator > span {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #edf1f7;
    color: #64748b;
    font-size: 14px;
    font-weight: 800;
}

.pdm-step-indicator strong,
.pdm-step-indicator small {
    display: block;
    white-space: nowrap;
}

.pdm-step-indicator strong {
    color: #243247;
    font-size: 13px;
}

.pdm-step-indicator small {
    margin-top: 3px;
    color: #8491a5;
    font-size: 11px;
}

.pdm-step-indicator.active {
    opacity: 1;
}

.pdm-step-indicator.active > span {
    background: #1d4ed8;
    color: #fff;
}

.pdm-step-indicator.completed {
    opacity: 1;
}

.pdm-step-indicator.completed > span {
    background: #dcfce7;
    color: #15803d;
}

.pdm-step-line {
    height: 2px;
    flex: 1;
    max-width: 65px;
    background: #e2e8f0;
}

.pdm-step {
    animation: pdmStepAppear .25s ease;
}

@keyframes pdmStepAppear {
    from {
        opacity: 0;
        transform: translateY(7px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.pdm-step-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 32px;
    padding-top: 22px;
    border-top: 1px solid #e9edf3;
}

.pdm-step-hint {
    color: #8491a5;
    font-size: 13px;
}

.pdm-step-actions button {
    min-height: 46px;
    cursor: pointer;
}

.pdm-step-actions button span {
    margin-left: 8px;
}

.pdm-review-box {
    margin: 24px 0;
    padding: 22px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #f8fafc;
}

.pdm-review-box h3 {
    margin: 0 0 16px;
    color: #1e293b;
    font-size: 17px;
}

.pdm-review-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    padding: 12px 0;
    border-bottom: 1px solid #e8edf3;
}

.pdm-review-row:last-child {
    border-bottom: 0;
}

.pdm-review-row span {
    color: #64748b;
    font-size: 14px;
}

.pdm-review-row strong {
    color: #1e293b;
    font-size: 14px;
    text-align: right;
    overflow-wrap: anywhere;
}

.pdm-sidebar {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    max-width: 1000px;
    margin: 24px auto 0;
}

.pdm-sidebar .process-card {
    display: none !important;
}

.pdm-sidebar .help-card,
.pdm-sidebar .sidebar-security {
    height: 100%;
}

@media (max-width: 760px) {
    .pdm-stepper {
        justify-content: flex-start;
        gap: 7px;
        padding: 16px 12px;
        overflow-x: auto;
    }

    .pdm-step-indicator {
        gap: 7px;
    }

    .pdm-step-indicator > span {
        width: 36px;
        height: 36px;
        font-size: 12px;
    }

    .pdm-step-indicator strong {
        font-size: 11px;
    }

    .pdm-step-indicator small {
        display: none;
    }

    .pdm-step-line {
        min-width: 14px;
    }

    .pdm-step-actions {
        flex-wrap: wrap;
    }

    .pdm-step-hint {
        order: 3;
        width: 100%;
        text-align: center;
    }

    .pdm-sidebar {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 480px) {
    .pdm-step-actions {
        gap: 10px;
    }

    .pdm-step-actions button {
        flex: 1;
        padding-left: 12px;
        padding-right: 12px;
    }

    .pdm-review-box {
        padding: 16px;
    }

    .pdm-review-row {
        flex-direction: column;
        gap: 5px;
    }

    .pdm-review-row strong {
        text-align: left;
    }
}

@media (prefers-reduced-motion: reduce) {
    .pdm-step {
        animation: none;
    }
}

/* =========================================
   PDM WIZARD - HOME PAGE VISUAL IDENTITY
   ========================================= */

.pdm-main {
    font-family: "Plus Jakarta Sans", sans-serif;
    background-color: #f5f7fc;
    color: #172033;
}

/* Kartu utama */
.pdm-form-card {
    background: #ffffff;
    border: 1px solid #d6deeb;
    border-radius: 18px;
}

/* Stepper */
.pdm-stepper {
    background: #ffffff;
    border: 1px solid #d6deeb;
    border-radius: 16px;
}

.pdm-step-number,
.pdm-step-indicator .step-number {
    background: #eaf0ff;
    color: #244fc5;
}

.pdm-step-indicator.active .pdm-step-number,
.pdm-step-indicator.active .step-number {
    background: #244fc5;
    color: #ffffff;
}

.pdm-step-indicator.completed .pdm-step-number,
.pdm-step-indicator.completed .step-number {
    background: #dcfce7;
    color: #15803d;
}

/* Judul dan teks */
.pdm-step h2,
.pdm-step h3,
.pdm-review-box h3 {
    color: #142650;
}

.pdm-step p,
.pdm-step-description {
    color: #4b5563;
}

/* Tombol utama */
.pdm-step-actions .pdm-next,
.pdm-step-actions button[type="submit"] {
    background: #244fc5;
    border-color: #244fc5;
    color: #ffffff;
    font-family: inherit;
    font-weight: 700;
    border-radius: 10px;
}

.pdm-step-actions .pdm-next:hover,
.pdm-step-actions button[type="submit"]:hover {
    background: #193d9f;
    border-color: #193d9f;
}

/* Tombol kembali */
.pdm-step-actions .pdm-prev {
    background: #ffffff;
    border: 1px solid #d6deeb;
    color: #142650;
    font-family: inherit;
    border-radius: 10px;
}

.pdm-step-actions .pdm-prev:hover {
    background: #eaf0ff;
    border-color: #244fc5;
    color: #244fc5;
}

/* Ringkasan konfirmasi */
.pdm-review-box {
    background: #f5f7fc;
    border: 1px solid #d6deeb;
    border-radius: 14px;
}

.pdm-review-box strong {
    color: #142650;
}

.pdm-review-box span {
    color: #4b5563;
}

/* Konsistensi font seluruh elemen form */
.pdm-main input,
.pdm-main select,
.pdm-main textarea,
.pdm-main button {
    font-family: "Plus Jakarta Sans", sans-serif;
}

/* Pastikan panel tersembunyi tetap tersembunyi */
.pdm-step[hidden],
.pdm-method-panel[hidden] {
    display: none !important;
}

/* Responsif */
@media (max-width: 760px) {
    .pdm-form-card,
    .pdm-stepper {
        border-radius: 14px;
    }
}

