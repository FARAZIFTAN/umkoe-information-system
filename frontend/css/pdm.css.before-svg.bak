/* ================================
   PDM PAGE
================================ */

.pdm-header {
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
}

.pdm-header-inner {
    width: min(1180px, calc(100% - 40px));
    min-height: 78px;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.pdm-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: #142650;
}

.pdm-brand-icon {
    width: 44px;
    height: 44px;
    border-radius: 13px;
    display: grid;
    place-items: center;
    background: #244fc5;
    color: white;
    font-size: 22px;
    font-weight: 800;
}

.pdm-brand strong,
.pdm-brand span {
    display: block;
}

.pdm-brand strong {
    font-size: 15px;
    font-weight: 800;
}

.pdm-brand span {
    margin-top: 3px;
    font-size: 11px;
    color: #64748b;
}

.pdm-back-link {
    color: #244fc5;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
}

.pdm-main {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: 35px 0 70px;
}

.pdm-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    color: #94a3b8;
    font-size: 12px;
}

.pdm-breadcrumb a {
    color: #244fc5;
    text-decoration: none;
}

.pdm-breadcrumb strong {
    color: #475569;
}

.pdm-heading-content {
    margin: 28px 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
}

.pdm-eyebrow {
    color: #244fc5;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

.pdm-heading h1 {
    margin: 9px 0 10px;
    color: #142650;
    font-size: clamp(26px, 4vw, 36px);
    line-height: 1.2;
    font-weight: 800;
}

.pdm-heading-content p {
    max-width: 650px;
    margin: 0;
    color: #64748b;
    font-size: 14px;
    line-height: 1.8;
}

.pdm-heading-icon {
    width: 90px;
    height: 90px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 25px;
    background: #eaf0ff;
    font-size: 38px;
}

.pdm-notice {
    display: flex;
    gap: 14px;
    padding: 18px 20px;
    margin-bottom: 25px;
    border: 1px solid #bfdbfe;
    border-radius: 13px;
    background: #eff6ff;
    color: #1e3a8a;
}

.notice-icon {
    font-size: 22px;
    font-weight: 800;
}

.pdm-notice strong {
    display: block;
    margin-bottom: 5px;
    font-size: 13px;
}

.pdm-notice p {
    margin: 0;
    font-size: 12px;
    line-height: 1.7;
}

.pdm-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    align-items: start;
    gap: 25px;
}

.pdm-form-card,
.sidebar-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 17px;
    box-shadow: 0 8px 25px rgba(20, 38, 80, 0.05);
}

.pdm-form-card {
    padding: 30px;
}

.pdm-card-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 25px;
}

.pdm-card-heading > div:first-child {
    position: relative;
    padding-left: 48px;
}

.section-number {
    position: absolute;
    left: 0;
    top: 0;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: #eaf0ff;
    color: #244fc5;
    font-size: 12px;
    font-weight: 800;
}

.pdm-card-heading h2 {
    margin: 0 0 6px;
    color: #142650;
    font-size: 18px;
    font-weight: 800;
}

.pdm-card-heading p {
    margin: 0;
    color: #64748b;
    font-size: 12px;
    line-height: 1.6;
}

.required-label {
    color: #dc2626;
    font-size: 11px;
    font-weight: 700;
}

.pdm-field {
    margin-bottom: 20px;
}

.pdm-field label {
    display: block;
    margin-bottom: 9px;
    color: #26344d;
    font-size: 13px;
    font-weight: 700;
}

.pdm-field label span {
    color: #dc2626;
}

.pdm-field input {
    width: 100%;
    min-height: 48px;
    padding: 12px 14px;
    border: 1px solid #cbd5e1;
    border-radius: 9px;
    outline: none;
    color: #172033;
    background: #ffffff;
    font: inherit;
    font-size: 13px;
    transition: border-color 0.2s, box-shadow 0.2s;
}

.pdm-field input:focus {
    border-color: #244fc5;
    box-shadow: 0 0 0 3px rgba(36, 79, 197, 0.12);
}

.pdm-field small {
    display: block;
    margin-top: 7px;
    color: #64748b;
    font-size: 11px;
}

.pdm-divider {
    height: 1px;
    margin: 30px 0;
    background: #e8edf5;
}

.document-heading {
    margin-bottom: 20px;
}

.upload-progress {
    padding: 15px;
    margin-bottom: 18px;
    border-radius: 11px;
    background: #f5f7fc;
}

.upload-progress-top {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
    color: #475569;
    font-size: 12px;
}

.upload-progress-top strong {
    color: #244fc5;
}

.progress-track {
    height: 8px;
    overflow: hidden;
    border-radius: 20px;
    background: #dbe3f1;
}

.progress-fill {
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: #244fc5;
    transition: width 0.25s ease;
}

.document-list {
    display: grid;
    gap: 12px;
}

.document-item {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 14px;
    border: 1px solid #e2e8f0;
    border-radius: 11px;
    transition: border-color 0.2s, background 0.2s;
}

.document-item.is-uploaded {
    border-color: #86efac;
    background: #f0fdf4;
}

.document-icon {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: #f1f5f9;
    font-size: 19px;
}

.document-info strong,
.document-info span {
    display: block;
}

.document-info strong {
    color: #26344d;
    font-size: 13px;
}

.document-info span {
    margin-top: 4px;
    color: #64748b;
    font-size: 11px;
}

.upload-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 9px 13px;
    border: 1px solid #c7d2fe;
    border-radius: 8px;
    color: #244fc5;
    background: #eff6ff;
    font-size: 11px;
    font-weight: 800;
    cursor: pointer;
}

.upload-button:hover {
    background: #dbeafe;
}

.upload-button input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
}

.file-status {
    grid-column: 2 / -1;
    color: #64748b;
    font-size: 11px;
    overflow-wrap: anywhere;
}

.document-item.is-uploaded .file-status {
    color: #15803d;
}

.pdm-upload-note {
    padding: 16px 18px;
    margin-top: 18px;
    border-radius: 10px;
    background: #fffbeb;
    color: #78350f;
}

.pdm-upload-note strong {
    font-size: 12px;
}

.pdm-upload-note ul {
    padding-left: 18px;
    margin: 8px 0 0;
}

.pdm-upload-note li {
    margin: 5px 0;
    font-size: 11px;
    line-height: 1.5;
}

.confirmation-check {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    color: #475569;
    font-size: 12px;
    line-height: 1.7;
    cursor: pointer;
}

.confirmation-check input {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
    margin-top: 2px;
    accent-color: #244fc5;
}

.form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 25px;
}

.button-primary,
.button-secondary {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 0 19px;
    border-radius: 9px;
    font-family: inherit;
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
    cursor: pointer;
}

.button-primary {
    border: 1px solid #244fc5;
    color: #ffffff;
    background: #244fc5;
}

.button-primary:hover {
    background: #193d9f;
}

.button-primary:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.button-secondary {
    border: 1px solid #cbd5e1;
    color: #475569;
    background: #ffffff;
}

.demo-disclaimer {
    margin: 15px 0 0;
    color: #94a3b8;
    font-size: 10px;
    text-align: right;
}

.pdm-sidebar {
    display: grid;
    gap: 17px;
}

.sidebar-card {
    padding: 22px;
}

.sidebar-card h3 {
    margin: 0 0 20px;
    color: #142650;
    font-size: 15px;
    font-weight: 800;
}

.process-step {
    position: relative;
    display: flex;
    gap: 12px;
    padding-bottom: 21px;
}

.process-step:last-child {
    padding-bottom: 0;
}

.process-step:not(:last-child)::after {
    position: absolute;
    top: 31px;
    left: 14px;
    width: 1px;
    height: calc(100% - 30px);
    background: #dbe3f1;
    content: "";
}

.process-step > span {
    z-index: 1;
    width: 29px;
    height: 29px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: #244fc5;
    background: #eaf0ff;
    font-size: 11px;
    font-weight: 800;
}

.process-step strong {
    display: block;
    margin: 2px 0 5px;
    color: #26344d;
    font-size: 12px;
}

.process-step p {
    margin: 0;
    color: #64748b;
    font-size: 11px;
    line-height: 1.6;
}

.help-card {
    background: #142650;
    border-color: #142650;
}

.help-card h3 {
    margin: 10px 0 8px;
    color: #ffffff;
}

.help-icon {
    font-size: 25px;
}

.help-card p {
    margin: 0 0 17px;
    color: #cbd5e1;
    font-size: 11px;
    line-height: 1.7;
}

.help-card a {
    color: #ffc83d;
    font-size: 11px;
    font-weight: 800;
    text-decoration: none;
}

.sidebar-security {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 15px;
    border: 1px solid #e2e8f0;
    border-radius: 11px;
    background: #ffffff;
}

.sidebar-security span {
    font-size: 19px;
}

.sidebar-security p {
    margin: 0;
    color: #64748b;
    font-size: 10px;
    line-height: 1.7;
}

.submission-result {
    max-width: 600px;
    margin: 35px auto;
    padding: 35px;
    border: 1px solid #bbf7d0;
    border-radius: 17px;
    background: #ffffff;
    text-align: center;
    box-shadow: 0 8px 25px rgba(20, 38, 80, 0.06);
}

.submission-result[hidden] {
    display: none;
}

.result-icon {
    width: 58px;
    height: 58px;
    display: grid;
    place-items: center;
    margin: 0 auto 17px;
    border-radius: 50%;
    color: #15803d;
    background: #dcfce7;
    font-size: 28px;
    font-weight: 800;
}

.submission-result h2 {
    margin: 0 0 10px;
    color: #142650;
    font-size: 22px;
}

.submission-result > p {
    color: #64748b;
    font-size: 12px;
    line-height: 1.7;
}

.tracking-box {
    display: grid;
    gap: 8px;
    padding: 17px;
    margin: 20px 0;
    border: 1px dashed #93c5fd;
    border-radius: 10px;
    background: #eff6ff;
}

.tracking-box span {
    color: #64748b;
    font-size: 11px;
}

.tracking-box strong {
    color: #244fc5;
    font-size: 23px;
    letter-spacing: 2px;
}

.tracking-box button {
    justify-self: center;
    border: 0;
    color: #244fc5;
    background: transparent;
    font: inherit;
    font-size: 11px;
    font-weight: 800;
    cursor: pointer;
}

.pdm-footer {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding: 22px max(20px, calc((100% - 1180px) / 2));
    border-top: 1px solid #e2e8f0;
    background: #ffffff;
}

.pdm-footer p,
.pdm-footer a {
    margin: 0;
    color: #64748b;
    font-size: 11px;
    text-decoration: none;
}

/* RESPONSIVE */

@media (max-width: 900px) {
    .pdm-layout {
        grid-template-columns: 1fr;
    }

    .pdm-sidebar {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sidebar-security {
        grid-column: 1 / -1;
    }
}

@media (max-width: 600px) {
    .pdm-header-inner,
    .pdm-main {
        width: calc(100% - 28px);
    }

    .pdm-header-inner {
        min-height: 68px;
    }

    .pdm-brand span {
        font-size: 9px;
    }

    .pdm-back-link {
        font-size: 11px;
    }

    .pdm-main {
        padding-top: 23px;
    }

    .pdm-heading-content {
        margin-top: 22px;
    }

    .pdm-heading-icon {
        width: 60px;
        height: 60px;
        border-radius: 17px;
        font-size: 27px;
    }

    .pdm-heading-content p {
        font-size: 12px;
    }

    .pdm-form-card {
        padding: 20px 15px;
    }

    .pdm-card-heading h2 {
        font-size: 16px;
    }

    .document-item {
        grid-template-columns: 34px minmax(0, 1fr) auto;
        gap: 9px;
        padding: 11px 9px;
    }

    .document-icon {
        width: 34px;
        height: 34px;
        font-size: 16px;
    }

    .document-info strong {
        font-size: 11px;
    }

    .document-info span {
        font-size: 9px;
    }

    .upload-button {
        padding: 8px 9px;
        font-size: 10px;
    }

    .file-status {
        grid-column: 2 / -1;
    }

    .pdm-sidebar {
        grid-template-columns: 1fr;
    }

    .sidebar-security {
        grid-column: auto;
    }

    .form-actions {
        flex-direction: column-reverse;
    }

    .form-actions a,
    .form-actions button {
        width: 100%;
    }

    .pdm-footer {
        flex-direction: column;
        text-align: center;
    }

    .submission-result {
        padding: 25px 17px;
    }

    .submission-result h2 {
        font-size: 19px;
    }
}

/* =================================
   PDM - METODE PENGIRIMAN
================================= */

.pdm-method-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 20px;
}

.pdm-method-option {
    position: relative;
    cursor: pointer;
}

.pdm-method-option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
}

.pdm-method-content {
    min-height: 145px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 17px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background: #ffffff;
    transition: 0.2s ease;
}

.pdm-method-option:hover .pdm-method-content {
    border-color: #93c5fd;
    background: #f8faff;
}

.pdm-method-option.active .pdm-method-content,
.pdm-method-option input:checked + .pdm-method-content {
    border-color: #244fc5;
    background: #eff6ff;
    box-shadow: 0 0 0 2px rgba(36, 79, 197, 0.08);
}

.pdm-method-icon {
    margin-bottom: 12px;
    font-size: 26px;
}

.pdm-method-content strong {
    color: #142650;
    font-size: 13px;
}

.pdm-method-content small {
    margin-top: 6px;
    color: #64748b;
    font-size: 10px;
    line-height: 1.6;
}

.pdm-method-panel[hidden] {
    display: none;
}

.pdm-archive-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 35px 20px;
    border: 2px dashed #cbd5e1;
    border-radius: 14px;
    background: #f8faff;
    text-align: center;
}

.pdm-archive-icon {
    margin-bottom: 12px;
    font-size: 42px;
}

.pdm-archive-box h3 {
    margin: 0 0 8px;
    color: #142650;
    font-size: 17px;
}

.pdm-archive-box p {
    margin: 0 0 18px;
    color: #64748b;
    font-size: 12px;
    line-height: 1.7;
}

.pdm-archive-box .file-status {
    margin-top: 12px;
    overflow-wrap: anywhere;
}

@media (max-width: 600px) {
    .pdm-method-grid {
        grid-template-columns: 1fr;
    }

    .pdm-method-content {
        min-height: auto;
        display: grid;
        grid-template-columns: 40px 1fr;
        align-items: center;
        gap: 0 10px;
    }

    .pdm-method-icon {
        grid-row: span 2;
        margin: 0;
    }

    .pdm-method-content small {
        margin-top: 4px;
    }
}

/* =====================================
   CEK BERKAS PERSYARATAN PDM
===================================== */

.pdm-requirements {
    display: flex;
    align-items: center;
    gap: 20px;
    margin: 25px 0 30px;
    padding: 24px 28px;
    background: linear-gradient(120deg, #eaf0fb, #f4f7fd);
    border: 1px solid #d7e2f3;
    border-radius: 18px;
}

.requirements-icon {
    width: 58px;
    height: 58px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #dce8ff;
    border-radius: 15px;
    font-size: 27px;
}

.requirements-content {
    flex: 1;
}

.requirements-label {
    display: block;
    margin-bottom: 6px;
    color: #536fa5;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.2px;
}

.requirements-content h2 {
    margin: 0 0 7px;
    color: #172b50;
    font-size: 17px;
    font-weight: 800;
}

.requirements-content p {
    margin: 0;
    color: #64748b;
    font-size: 13px;
    line-height: 1.7;
}

.requirements-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-shrink: 0;
    padding: 13px 19px;
    background: #244b91;
    color: #fff;
    border-radius: 11px;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.25s ease;
}

.requirements-button:hover {
    background: #17366f;
    transform: translateY(-2px);
    box-shadow: 0 7px 16px rgba(36, 75, 145, 0.2);
}

.requirements-button span {
    font-size: 16px;
}

@media (max-width: 650px) {
    .pdm-requirements {
        flex-wrap: wrap;
        gap: 14px;
        padding: 20px;
    }

    .requirements-content {
        flex-basis: calc(100% - 75px);
    }

    .requirements-content h2 {
        font-size: 15px;
    }

    .requirements-button {
        width: 100%;
    }
}


/* =========================================
   PDM CONTENT - VISUAL REFINEMENT
   Navbar dan footer tidak diubah.
========================================= */

.pdm-main {
    width: min(1220px, calc(100% - 48px));
    padding-top: 42px;
    padding-bottom: 80px;
}

.pdm-heading {
    margin-bottom: 28px;
}

.pdm-heading-content {
    gap: 22px;
}

.pdm-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border: 1px solid #dbe5ff;
    border-radius: 30px;
    background: #f0f4ff;
    color: #244fc5;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.7px;
}

.pdm-heading h1 {
    margin-top: 14px;
    color: #142650;
    font-size: clamp(28px, 4vw, 38px);
    line-height: 1.2;
    letter-spacing: -1.1px;
}

.pdm-heading-content p {
    max-width: 650px;
    margin-top: 12px;
    color: #64748b;
    font-size: 14px;
    line-height: 1.8;
}

.pdm-heading-icon {
    flex-shrink: 0;
    box-shadow: 0 12px 28px rgba(36, 79, 197, 0.15);
}

/* Informasi dan persyaratan */

.pdm-notice {
    padding: 19px 22px;
    border: 1px solid #dbe5ff;
    border-radius: 15px;
    background: linear-gradient(135deg, #f0f5ff, #ffffff);
    box-shadow: 0 5px 18px rgba(20, 38, 80, 0.035);
}

.pdm-notice p {
    line-height: 1.75;
}

.pdm-requirements {
    align-items: center;
    padding: 25px 28px;
    border: 1px solid #dbe5ff;
    border-radius: 18px;
    background: linear-gradient(120deg, #edf3ff, #f8faff);
    box-shadow: 0 8px 25px rgba(20, 38, 80, 0.045);
}

.requirements-icon {
    flex-shrink: 0;
}

.requirements-content h2 {
    color: #142650;
    font-size: 17px;
    font-weight: 800;
}

.requirements-content p {
    color: #64748b;
    font-size: 13px;
    line-height: 1.7;
}

.requirements-button {
    min-height: 43px;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 800;
    transition: transform 0.2s, box-shadow 0.2s;
}

.requirements-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 7px 18px rgba(36, 79, 197, 0.14);
}

/* Layout utama */

.pdm-layout {
    align-items: start;
    grid-template-columns: minmax(0, 1fr) 310px;
    gap: 28px;
}

.pdm-form-card,
.sidebar-card {
    border: 1px solid #e3e9f3;
    border-radius: 18px;
    background: #ffffff;
    box-shadow: 0 8px 28px rgba(20, 38, 80, 0.055);
}

.pdm-form-card {
    padding: 34px;
}

.pdm-card-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 24px;
}

.section-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    height: 30px;
    margin-bottom: 12px;
    padding: 0 9px;
    border: 1px solid #dbe5ff;
    border-radius: 8px;
    background: #eff4ff;
    color: #244fc5;
    font-size: 12px;
    font-weight: 900;
}

.pdm-card-heading h2 {
    margin: 0;
    color: #142650;
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -0.3px;
}

.pdm-card-heading p {
    margin-top: 7px;
    color: #64748b;
    font-size: 13px;
    line-height: 1.65;
}

.required-label {
    padding: 7px 11px;
    border-radius: 30px;
    background: #fff5f5;
    color: #dc2626;
    font-size: 10px;
    font-weight: 800;
    white-space: nowrap;
}

/* Input identitas dan link */

.pdm-field {
    margin-bottom: 20px;
}

.pdm-field label {
    display: block;
    margin-bottom: 9px;
    color: #26344d;
    font-size: 13px;
    font-weight: 750;
}

.pdm-field label span {
    color: #dc2626;
}

.pdm-field input {
    width: 100%;
    min-height: 48px;
    padding: 0 15px;
    border: 1px solid #d8e0ed;
    border-radius: 10px;
    background: #fbfcff;
    color: #172033;
    font-family: inherit;
    font-size: 14px;
    transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
}

.pdm-field input::placeholder {
    color: #a0aabd;
}

.pdm-field input:hover {
    border-color: #aebfe2;
}

.pdm-field input:focus {
    outline: none;
    border-color: #4168d5;
    background: #ffffff;
    box-shadow: 0 0 0 4px rgba(36, 79, 197, 0.10);
}

.pdm-field small {
    margin-top: 9px;
    font-size: 12px;
    line-height: 1.7;
}

.pdm-divider {
    margin: 32px 0;
    background: #e9edf5;
}

/* Pilihan metode pengiriman */

.pdm-method-grid {
    gap: 14px;
}

.pdm-method-option {
    position: relative;
    min-width: 0;
    cursor: pointer;
}

.pdm-method-content {
    min-height: 145px;
    padding: 19px 15px;
    border: 1px solid #e1e7f0;
    border-radius: 13px;
    background: #ffffff;
    transition: border-color 0.2s, background 0.2s, transform 0.2s, box-shadow 0.2s;
}

.pdm-method-option:hover .pdm-method-content {
    transform: translateY(-3px);
    border-color: #a9bce9;
    box-shadow: 0 8px 20px rgba(20, 38, 80, 0.06);
}

.pdm-method-option:has(input:checked) .pdm-method-content {
    border: 1.5px solid #4168d5;
    background: #f3f6ff;
    box-shadow: 0 0 0 3px rgba(36, 79, 197, 0.07);
}

.pdm-method-option input {
    position: absolute;
    top: 13px;
    right: 13px;
    accent-color: #244fc5;
}

.pdm-method-icon {
    display: grid;
    width: 43px;
    height: 43px;
    margin-bottom: 15px;
    place-items: center;
    border-radius: 12px;
    background: #edf3ff;
    font-size: 22px;
}

.pdm-method-content strong {
    display: block;
    margin-bottom: 7px;
    color: #26344d;
    font-size: 14px;
}

.pdm-method-content small {
    color: #64748b;
    font-size: 11px;
    line-height: 1.6;
}

/* Panel dokumen */

.pdm-method-panel[hidden] {
    display: none !important;
}

.document-heading {
    margin-bottom: 22px;
}

.upload-progress {
    padding: 18px;
    margin-bottom: 20px;
    border: 1px solid #e4eaf5;
    border-radius: 13px;
    background: #f8faff;
}

.upload-progress-top {
    margin-bottom: 12px;
    color: #475569;
    font-size: 13px;
}

.upload-progress-top strong {
    color: #244fc5;
    font-size: 13px;
}

.progress-track {
    height: 10px;
    background: #e2e8f4;
}

.progress-fill {
    background: linear-gradient(90deg, #244fc5, #6285ed);
}

/* Daftar dokumen */

.document-list {
    gap: 13px;
}

.document-item {
    grid-template-columns: 44px minmax(0, 1fr) auto;
    gap: 13px;
    padding: 15px;
    border: 1px solid #e3e9f2;
    border-radius: 13px;
    background: #ffffff;
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
}

.document-item:hover {
    border-color: #b8c8ed;
    box-shadow: 0 5px 16px rgba(20, 38, 80, 0.045);
}

.document-item.is-uploaded {
    border-color: #86d9a3;
    background: #f3fcf6;
}

.document-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #f0f4fb;
    font-size: 21px;
}

.document-info strong {
    color: #26344d;
    font-size: 13px;
    line-height: 1.5;
}

.document-info span {
    font-size: 12px;
    line-height: 1.5;
}

.upload-button {
    min-height: 36px;
    padding: 0 13px;
    border: 1px solid #cbd8f5;
    border-radius: 9px;
    background: #f0f4ff;
    color: #244fc5;
    font-size: 12px;
    font-weight: 800;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
}

.upload-button:hover {
    transform: translateY(-1px);
    border-color: #8da6e7;
    background: #e2eaff;
}

.upload-button:focus-within {
    outline: 3px solid rgba(36, 79, 197, 0.15);
    outline-offset: 2px;
}

.file-status {
    padding-top: 2px;
    font-size: 11px;
    line-height: 1.5;
}

.pdm-upload-note {
    padding: 18px 20px;
    border: 1px solid #f6df9a;
    border-radius: 12px;
    background: #fffbeb;
}

.pdm-upload-note strong {
    font-size: 13px;
}

.pdm-upload-note li {
    font-size: 12px;
    line-height: 1.7;
}

/* Arsip */

.pdm-archive-box {
    padding: 32px 20px;
    border: 1.5px dashed #b8c8ed;
    border-radius: 15px;
    background: #f8faff;
    text-align: center;
}

.pdm-archive-icon {
    display: grid;
    width: 65px;
    height: 65px;
    margin: 0 auto 15px;
    place-items: center;
    border-radius: 18px;
    background: #eaf0ff;
    font-size: 30px;
}

.pdm-archive-box h3 {
    margin-bottom: 8px;
    color: #142650;
    font-size: 18px;
}

.pdm-archive-box p {
    margin-bottom: 18px;
    color: #64748b;
    font-size: 13px;
    line-height: 1.7;
}

.pdm-archive-box .file-status {
    margin-top: 13px;
}

/* Konfirmasi */

.confirmation-check {
    padding: 17px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background: #f8faff;
    color: #475569;
    font-size: 13px;
    line-height: 1.8;
}

.confirmation-check input {
    width: 19px;
    height: 19px;
    accent-color: #244fc5;
}

.form-actions {
    margin-top: 28px;
}

.button-primary,
.button-secondary {
    min-height: 47px;
    padding: 0 22px;
    border-radius: 10px;
    font-size: 13px;
    transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
}

.button-primary {
    border-color: #244fc5;
    background: linear-gradient(135deg, #244fc5, #3862d4);
    box-shadow: 0 5px 14px rgba(36, 79, 197, 0.16);
}

.button-primary:hover:not(:disabled) {
    transform: translateY(-2px);
    background: #193d9f;
    box-shadow: 0 8px 18px rgba(36, 79, 197, 0.22);
}

.button-secondary:hover {
    transform: translateY(-2px);
    border-color: #aebbd0;
    background: #f8faff;
}

.demo-disclaimer {
    margin-top: 17px;
    font-size: 11px;
    line-height: 1.6;
}

/* Sidebar */

.pdm-sidebar {
    gap: 18px;
}

.sidebar-card {
    padding: 24px;
}

.sidebar-card h3 {
    margin-bottom: 23px;
    font-size: 16px;
}

.process-step {
    gap: 13px;
    padding-bottom: 24px;
}

.process-step > span {
    width: 32px;
    height: 32px;
    border: 1px solid #dce6ff;
    background: #edf3ff;
    font-size: 12px;
}

.process-step:not(:last-child)::after {
    left: 15px;
    background: #dce5f5;
}

.process-step strong {
    font-size: 13px;
}

.process-step p {
    font-size: 12px;
    line-height: 1.7;
}

.help-card {
    background: linear-gradient(145deg, #142650, #203e79);
    box-shadow: 0 10px 25px rgba(20, 38, 80, 0.13);
}

.help-card h3 {
    font-size: 17px;
}

.help-card p {
    font-size: 12px;
    line-height: 1.8;
}

.help-card a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 13px;
    border: 1px solid rgba(255, 200, 61, 0.3);
    border-radius: 9px;
    background: rgba(255, 200, 61, 0.08);
    font-size: 12px;
}

.help-card a:hover {
    background: rgba(255, 200, 61, 0.16);
}

.sidebar-security {
    padding: 17px;
    border-color: #dce7f5;
    border-radius: 13px;
    background: #f8faff;
}

.sidebar-security p {
    font-size: 11px;
    line-height: 1.8;
}

/* Hasil validasi */

.submission-result {
    padding: 40px;
    border-color: #bce8ca;
    border-radius: 20px;
    box-shadow: 0 12px 35px rgba(20, 38, 80, 0.07);
}

.submission-result h2 {
    font-size: 25px;
    letter-spacing: -0.5px;
}

.submission-result > p {
    font-size: 13px;
    line-height: 1.8;
}

.tracking-box {
    padding: 20px;
    border-color: #b8c8ed;
    border-radius: 13px;
}

/* Aksesibilitas */

.pdm-main button:focus-visible,
.pdm-main a:focus-visible,
.pdm-main input:focus-visible {
    outline: 3px solid rgba(36, 79, 197, 0.22);
    outline-offset: 3px;
}

/* Responsive tablet */

@media (max-width: 900px) {
    .pdm-main {
        width: min(100% - 36px, 760px);
    }

    .pdm-layout {
        grid-template-columns: minmax(0, 1fr);
    }

    .pdm-sidebar {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sidebar-security {
        grid-column: 1 / -1;
    }
}

/* Responsive mobile */

@media (max-width: 600px) {
    .pdm-main {
        width: calc(100% - 28px);
        padding-top: 25px;
        padding-bottom: 45px;
    }

    .pdm-heading h1 {
        font-size: 27px;
    }

    .pdm-heading-content p {
        font-size: 13px;
    }

    .pdm-notice {
        padding: 16px;
    }

    .pdm-requirements {
        padding: 19px;
    }

    .requirements-content h2 {
        font-size: 16px;
    }

    .pdm-form-card {
        padding: 22px 17px;
    }

    .pdm-card-heading h2 {
        font-size: 17px;
    }

    .pdm-card-heading p {
        font-size: 12px;
    }

    .pdm-method-grid {
        grid-template-columns: 1fr;
    }

    .pdm-method-content {
        min-height: auto;
        padding: 15px;
    }

    .pdm-method-icon {
        width: 39px;
        height: 39px;
        margin-bottom: 10px;
    }

    .document-item {
        grid-template-columns: 38px minmax(0, 1fr) auto;
        gap: 9px;
        padding: 12px 10px;
    }

    .document-icon {
        width: 38px;
        height: 38px;
        font-size: 18px;
    }

    .document-info strong {
        font-size: 12px;
    }

    .document-info span {
        font-size: 10px;
    }

    .upload-button {
        min-height: 34px;
        padding: 0 9px;
        font-size: 10px;
    }

    .file-status {
        grid-column: 2 / -1;
        font-size: 10px;
    }

    .pdm-sidebar {
        grid-template-columns: 1fr;
    }

    .sidebar-security {
        grid-column: auto;
    }

    .form-actions {
        flex-direction: column-reverse;
    }

    .form-actions a,
    .form-actions button {
        width: 100%;
    }

    .demo-disclaimer {
        text-align: center;
    }

    .submission-result {
        padding: 27px 18px;
    }
}


/* ==========================================
   PDM MODERN REDESIGN - CONTENT ONLY
   Tidak mengubah navbar, footer, dan JavaScript
========================================== */

/* Warna dan area konten */
.pdm-main {
    width: min(1280px, calc(100% - 56px));
    padding-top: 48px;
    padding-bottom: 85px;
}

/* Judul halaman */
.pdm-heading-content {
    gap: 28px;
}

.pdm-eyebrow {
    padding: 8px 15px;
    border: 1px solid #cddcff;
    border-radius: 30px;
    background: #edf3ff;
    color: #2453c5;
    font-size: 12px;
    font-weight: 800;
}

.pdm-heading h1 {
    margin-top: 16px;
    color: #10234b;
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 850;
    letter-spacing: -1.5px;
    line-height: 1.2;
}

.pdm-heading-content p {
    max-width: 700px;
    margin-top: 14px;
    color: #596a85;
    font-size: 15px;
    line-height: 1.9;
}

.pdm-heading-icon {
    width: 88px;
    height: 88px;
    border-radius: 25px;
    background: linear-gradient(145deg, #315fd3, #173b9c);
    color: white;
    box-shadow: 0 15px 30px rgba(36, 79, 197, .22);
}

/* Informasi */
.pdm-notice {
    padding: 23px 25px;
    border: 1px solid #d5e3ff;
    border-left: 5px solid #3263d5;
    border-radius: 16px;
    background: linear-gradient(110deg, #edf4ff, #ffffff);
    box-shadow: 0 8px 25px rgba(24, 53, 105, .045);
}

.pdm-notice strong {
    color: #18366f;
    font-size: 15px;
}

.pdm-notice p {
    color: #596a85;
    font-size: 14px;
    line-height: 1.8;
}

/* Kartu persyaratan */
.pdm-requirements {
    padding: 28px 30px;
    border: 1px solid #d6e2fa;
    border-radius: 20px;
    background: linear-gradient(120deg, #eaf1ff, #f7f9ff 65%, #ffffff);
    box-shadow: 0 10px 30px rgba(24, 53, 105, .06);
}

.requirements-icon {
    display: grid;
    width: 58px;
    height: 58px;
    flex-shrink: 0;
    place-items: center;
    border-radius: 17px;
    background: #dce8ff;
    color: #2453c5;
    font-size: 28px;
}

.requirements-label {
    color: #3260c5;
    font-size: 11px;
    font-weight: 850;
    letter-spacing: 1px;
}

.requirements-content h2 {
    margin-top: 7px;
    color: #142b58;
    font-size: 20px;
    font-weight: 850;
}

.requirements-content p {
    margin-top: 8px;
    color: #60708a;
    font-size: 14px;
    line-height: 1.8;
}

.requirements-button {
    min-height: 46px;
    padding: 0 20px;
    border-radius: 11px;
    background: #2453c5;
    color: #fff;
    font-size: 13px;
    font-weight: 800;
}

/* Layout dua kolom */
.pdm-layout {
    grid-template-columns: minmax(0, 1fr) 325px;
    align-items: start;
    gap: 30px;
}

.pdm-form-card {
    padding: 38px;
    border: 1px solid #e0e7f2;
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 12px 35px rgba(18, 42, 87, .065);
}

.pdm-sidebar {
    gap: 20px;
}

/* Heading setiap bagian formulir */
.pdm-card-heading {
    margin-bottom: 28px;
    gap: 18px;
}

.section-number {
    min-width: 40px;
    height: 34px;
    margin-bottom: 14px;
    border: 1px solid #cbdcff;
    border-radius: 10px;
    background: linear-gradient(135deg, #e8efff, #f5f8ff);
    color: #2453c5;
    font-size: 13px;
    font-weight: 900;
}

.pdm-card-heading h2 {
    color: #142b58;
    font-size: 22px;
    font-weight: 850;
    letter-spacing: -.5px;
}

.pdm-card-heading p {
    margin-top: 9px;
    color: #687891;
    font-size: 14px;
    line-height: 1.7;
}

.required-label {
    padding: 8px 12px;
    border: 1px solid #fecaca;
    border-radius: 30px;
    background: #fff1f2;
    color: #dc2626;
    font-size: 11px;
}

/* Form input */
.pdm-field {
    margin-bottom: 24px;
}

.pdm-field label {
    margin-bottom: 11px;
    color: #273957;
    font-size: 15px;
    font-weight: 750;
}

.pdm-field input {
    min-height: 54px;
    padding: 0 17px;
    border: 1px solid #d8e1ef;
    border-radius: 12px;
    background: #fbfcff;
    color: #172033;
    font-size: 15px;
}

.pdm-field input::placeholder {
    color: #9aa8bd;
}

.pdm-field input:focus {
    border-color: #3867d6;
    box-shadow: 0 0 0 4px rgba(49, 95, 211, .11);
}

.pdm-field small {
    color: #6b7b93;
    font-size: 13px;
    line-height: 1.8;
}

.pdm-divider {
    margin: 38px 0;
    background: #e9edf5;
}

/* Metode pengiriman */
.pdm-method-grid {
    gap: 16px;
}

.pdm-method-content {
    min-height: 165px;
    padding: 21px 18px;
    border: 1px solid #dfe6f1;
    border-radius: 16px;
    background: #fff;
    transition: all .22s ease;
}

.pdm-method-option:hover .pdm-method-content {
    transform: translateY(-4px);
    border-color: #9eb6ed;
    box-shadow: 0 12px 24px rgba(28, 61, 125, .09);
}

.pdm-method-option:has(input:checked) .pdm-method-content {
    border: 2px solid #3262d1;
    background: linear-gradient(145deg, #edf3ff, #ffffff);
    box-shadow: 0 0 0 4px rgba(50, 98, 209, .08);
}

.pdm-method-option input {
    width: 18px;
    height: 18px;
    accent-color: #2453c5;
}

.pdm-method-icon {
    width: 51px;
    height: 51px;
    margin-bottom: 17px;
    border-radius: 15px;
    background: linear-gradient(145deg, #e2ebff, #f2f6ff);
    font-size: 27px;
}

.pdm-method-content strong {
    margin-bottom: 8px;
    color: #1d345f;
    font-size: 15px;
    font-weight: 850;
}

.pdm-method-content small {
    color: #687891;
    font-size: 12px;
    line-height: 1.7;
}

/* Progres dokumen */
.upload-progress {
    padding: 21px;
    margin-bottom: 22px;
    border: 1px solid #e0e8f5;
    border-radius: 15px;
    background: linear-gradient(120deg, #f3f7ff, #fbfcff);
}

.upload-progress-top {
    color: #425575;
    font-size: 14px;
}

.upload-progress-top strong {
    color: #2453c5;
    font-size: 14px;
}

.progress-track {
    height: 11px;
    border-radius: 20px;
    background: #dfe7f5;
}

.progress-fill {
    border-radius: 20px;
    background: linear-gradient(90deg, #2453c5, #6c91f2);
    box-shadow: 0 2px 8px rgba(36, 83, 197, .2);
}

/* Daftar dokumen */
.document-list {
    gap: 14px;
}

.document-item {
    grid-template-columns: 50px minmax(0, 1fr) auto;
    gap: 15px;
    padding: 17px;
    border: 1px solid #e1e8f2;
    border-radius: 15px;
    background: #fff;
    transition: all .2s ease;
}

.document-item:hover {
    transform: translateY(-2px);
    border-color: #b5c9ef;
    box-shadow: 0 8px 20px rgba(28, 61, 125, .06);
}

.document-item.is-uploaded {
    border-color: #91d9a8;
    background: linear-gradient(110deg, #effbf3, #ffffff);
}

.document-icon {
    width: 50px;
    height: 50px;
    border: 1px solid #e0e9fa;
    border-radius: 15px;
    background: linear-gradient(145deg, #eaf1ff, #f5f8ff);
    font-size: 25px;
}

.document-info strong {
    color: #1e345b;
    font-size: 14px;
    font-weight: 800;
}

.document-info span {
    margin-top: 6px;
    color: #718099;
    font-size: 12px;
    line-height: 1.6;
}

.upload-button {
    min-height: 40px;
    padding: 0 15px;
    border: 1px solid #c6d6fa;
    border-radius: 10px;
    background: #edf3ff;
    color: #2453c5;
    font-size: 12px;
    font-weight: 850;
}

.upload-button:hover {
    border-color: #8ba8e9;
    background: #dfeaff;
}

.file-status {
    color: #78869b;
    font-size: 12px;
    line-height: 1.6;
}

.document-item.is-uploaded .file-status {
    color: #15803d;
    font-weight: 700;
}

/* Catatan unggahan */
.pdm-upload-note {
    padding: 21px 23px;
    border: 1px solid #f2dfa9;
    border-radius: 15px;
    background: linear-gradient(120deg, #fff8e6, #fffdf7);
    color: #805619;
}

.pdm-upload-note strong {
    color: #85540b;
    font-size: 14px;
}

.pdm-upload-note li {
    margin: 7px 0;
    color: #78613d;
    font-size: 13px;
    line-height: 1.7;
}

/* Panel arsip */
.pdm-archive-box {
    padding: 38px 24px;
    border: 2px dashed #b8c9ed;
    border-radius: 18px;
    background: linear-gradient(145deg, #f0f5ff, #fbfcff);
    text-align: center;
}

.pdm-archive-icon {
    width: 75px;
    height: 75px;
    margin-bottom: 20px;
    border-radius: 22px;
    background: linear-gradient(145deg, #dce8ff, #edf3ff);
    font-size: 35px;
}

.pdm-archive-box h3 {
    color: #193465;
    font-size: 21px;
    font-weight: 850;
}

.pdm-archive-box p {
    margin: 10px auto 20px;
    color: #687891;
    font-size: 14px;
    line-height: 1.8;
}

/* Konfirmasi */
.confirmation-check {
    padding: 20px;
    border: 1px solid #dfe7f2;
    border-radius: 14px;
    background: #f7f9fd;
    color: #425575;
    font-size: 14px;
    line-height: 1.8;
}

.confirmation-check input {
    width: 20px;
    height: 20px;
    accent-color: #2453c5;
}

/* Tombol */
.form-actions {
    gap: 14px;
    margin-top: 30px;
}

.button-primary,
.button-secondary {
    min-height: 52px;
    padding: 0 25px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 850;
}

.button-primary {
    border: 1px solid #2453c5;
    background: linear-gradient(120deg, #2453c5, #386ce0);
    box-shadow: 0 7px 18px rgba(36, 83, 197, .2);
}

.button-primary:hover:not(:disabled) {
    transform: translateY(-2px);
    background: linear-gradient(120deg, #193d9f, #2858c4);
    box-shadow: 0 10px 22px rgba(36, 83, 197, .25);
}

.button-secondary {
    border: 1px solid #d5deeb;
    background: #fff;
    color: #425575;
}

.demo-disclaimer {
    margin-top: 20px;
    color: #8190a6;
    font-size: 12px;
}

/* Sidebar */
.sidebar-card {
    padding: 27px;
    border: 1px solid #e0e7f1;
    border-radius: 19px;
    background: #fff;
    box-shadow: 0 10px 28px rgba(18, 42, 87, .055);
}

.sidebar-card h3 {
    margin-bottom: 25px;
    color: #142b58;
    font-size: 18px;
    font-weight: 850;
}

.process-step {
    gap: 14px;
    padding-bottom: 27px;
}

.process-step > span {
    width: 36px;
    height: 36px;
    border: 1px solid #d4e1ff;
    background: #eaf1ff;
    color: #2453c5;
    font-size: 13px;
    font-weight: 900;
}

.process-step:not(:last-child)::after {
    top: 36px;
    left: 17px;
    background: #d8e3f6;
}

.process-step strong {
    margin-top: 3px;
    color: #253b62;
    font-size: 14px;
}

.process-step p {
    color: #6b7b94;
    font-size: 13px;
    line-height: 1.7;
}

.help-card {
    border: 0;
    background: linear-gradient(145deg, #142b58, #2453a5);
    box-shadow: 0 13px 30px rgba(20, 43, 88, .18);
}

.help-icon {
    display: grid;
    width: 52px;
    height: 52px;
    place-items: center;
    border: 1px solid rgba(255,255,255,.15);
    border-radius: 16px;
    background: rgba(255,255,255,.1);
    font-size: 27px;
}

.help-card h3 {
    margin: 16px 0 9px;
    color: #fff;
    font-size: 19px;
}

.help-card p {
    color: #d8e4fa;
    font-size: 13px;
    line-height: 1.8;
}

.help-card a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid rgba(255, 200, 61, .35);
    border-radius: 10px;
    background: rgba(255, 200, 61, .12);
    color: #ffdb73;
    font-size: 13px;
}

.sidebar-security {
    padding: 19px;
    border: 1px solid #dce6f4;
    border-radius: 15px;
    background: #f4f7fc;
}

.sidebar-security span {
    font-size: 23px;
}

.sidebar-security p {
    color: #5d6e87;
    font-size: 12px;
    line-height: 1.8;
}

/* Hasil simulasi */
.submission-result {
    max-width: 680px;
    padding: 45px;
    border: 1px solid #bce8ca;
    border-radius: 22px;
    box-shadow: 0 15px 40px rgba(18, 42, 87, .08);
}

.result-icon {
    width: 70px;
    height: 70px;
    background: linear-gradient(145deg, #dcfce7, #bbf7d0);
    font-size: 34px;
}

.submission-result h2 {
    color: #142b58;
    font-size: 27px;
}

.submission-result > p {
    color: #65758e;
    font-size: 14px;
    line-height: 1.9;
}

.tracking-box {
    padding: 23px;
    border: 1px dashed #9bb7ef;
    border-radius: 15px;
    background: #f1f6ff;
}

.tracking-box span {
    font-size: 13px;
}

.tracking-box strong {
    color: #2453c5;
    font-size: 27px;
}

/* Tablet */
@media (max-width: 1000px) {
    .pdm-main {
        width: min(100% - 40px, 820px);
    }

    .pdm-layout {
        grid-template-columns: minmax(0, 1fr);
    }

    .pdm-sidebar {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sidebar-security {
        grid-column: 1 / -1;
    }
}

/* Mobile */
@media (max-width: 600px) {
    .pdm-main {
        width: calc(100% - 28px);
        padding-top: 28px;
        padding-bottom: 48px;
    }

    .pdm-heading h1 {
        font-size: 29px;
        letter-spacing: -.8px;
    }

    .pdm-heading-content p {
        font-size: 14px;
    }

    .pdm-heading-icon {
        width: 65px;
        height: 65px;
        border-radius: 19px;
        font-size: 25px;
    }

    .pdm-notice {
        padding: 17px;
    }

    .pdm-notice p {
        font-size: 13px;
    }

    .pdm-requirements {
        padding: 20px;
        gap: 15px;
    }

    .requirements-content h2 {
        font-size: 17px;
    }

    .requirements-content p {
        font-size: 13px;
    }

    .pdm-form-card {
        padding: 23px 17px;
        border-radius: 17px;
    }

    .pdm-card-heading h2 {
        font-size: 19px;
    }

    .pdm-card-heading p {
        font-size: 13px;
    }

    .required-label {
        font-size: 10px;
    }

    .pdm-field label {
        font-size: 14px;
    }

    .pdm-field input {
        min-height: 51px;
        font-size: 14px;
    }

    .pdm-method-grid {
        grid-template-columns: 1fr;
    }

    .pdm-method-content {
        min-height: 125px;
        padding: 16px;
    }

    .pdm-method-icon {
        width: 44px;
        height: 44px;
        margin-bottom: 11px;
    }

    .document-item {
        grid-template-columns: 42px minmax(0, 1fr) auto;
        gap: 10px;
        padding: 12px 10px;
    }

    .document-icon {
        width: 42px;
        height: 42px;
        font-size: 21px;
    }

    .document-info strong {
        font-size: 12px;
    }

    .document-info span {
        font-size: 11px;
    }

    .upload-button {
        min-height: 36px;
        padding: 0 9px;
        font-size: 10px;
    }

    .file-status {
        grid-column: 2 / -1;
        font-size: 11px;
    }

    .confirmation-check {
        padding: 15px;
        font-size: 13px;
    }

    .pdm-sidebar {
        grid-template-columns: 1fr;
    }

    .sidebar-security {
        grid-column: auto;
    }

    .sidebar-card {
        padding: 22px;
    }

    .form-actions {
        flex-direction: column-reverse;
    }

    .form-actions a,
    .form-actions button {
        width: 100%;
    }

    .demo-disclaimer {
        text-align: center;
        font-size: 11px;
    }

    .submission-result {
        padding: 28px 18px;
    }

    .submission-result h2 {
        font-size: 22px;
    }
}

/* Mengurangi animasi bagi pengguna yang membutuhkannya */
@media (prefers-reduced-motion: reduce) {
    .pdm-main *,
    .pdm-main *::before,
    .pdm-main *::after {
        scroll-behavior: auto !important;
        animation-duration: .01ms !important;
        transition-duration: .01ms !important;
    }
}

