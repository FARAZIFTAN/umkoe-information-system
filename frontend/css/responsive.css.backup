/* ==========================================
   TABLET
========================================== */

@media (max-width: 1024px) {
    .navbar {
        gap: 18px;
    }

    .nav-menu {
        gap: 16px;
    }

    .hero-layout {
        grid-template-columns: 1fr 0.9fr;
        gap: 30px;
    }

    .hero h1 {
        font-size: clamp(38px, 5vw, 50px);
    }

    .service-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-content {
        gap: 35px;
    }
}

/* ==========================================
   MOBILE
========================================== */

@media (max-width: 768px) {
    .navbar {
        min-height: 70px;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 12px;
        padding-bottom: 12px;
    }

    .brand-icon {
        width: 40px;
        height: 40px;
    }

    .brand-text strong {
        font-size: 17px;
    }

    .brand-text small {
        font-size: 9px;
    }

    .nav-menu {
        order: 3;
        width: 100%;
        justify-content: flex-start;
        overflow-x: auto;
        gap: 22px;
        padding: 10px 0;
    }

    .nav-menu a {
        white-space: nowrap;
        font-size: 14px;
    }

    .nav-admin {
        padding: 9px 13px;
        font-size: 13px;
    }

    /* Hero */
    .hero-layout {
        min-height: auto;
        grid-template-columns: 1fr;
        gap: 35px;
        padding-top: 65px;
        padding-bottom: 55px;
    }

    .hero h1 {
        font-size: clamp(34px, 7vw, 44px);
        letter-spacing: -1.2px;
    }

    .hero-description {
        font-size: 15px;
    }

    .hero-visual {
        min-height: 390px;
    }

    .dashboard-card {
        padding: 20px;
        transform: none;
    }

    .floating-card-top {
        right: 0;
    }

    .floating-card-bottom {
        left: 0;
    }

    /* Quick information */
    .quick-info-grid {
        grid-template-columns: 1fr;
        padding: 12px 0;
    }

    .quick-info-item {
        padding: 15px 5px;
        border-right: none;
        border-bottom: 1px solid var(--border);
    }

    .quick-info-item:last-child {
        border-bottom: none;
    }

    /* Sections */
    .section {
        padding: 65px 0;
    }

    .section-heading {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 30px;
    }

    .section-heading h2 {
        font-size: 30px;
    }

    .section-heading > p {
        font-size: 14px;
    }

    /* Service cards */
    .service-grid {
        grid-template-columns: 1fr;
        gap: 16px;
    }

    .service-card {
        padding: 24px;
    }

    .service-card h3 {
        min-height: auto;
    }

    .service-card p {
        min-height: auto;
    }

    /* Infrastructure */
    .infrastructure-grid {
        grid-template-columns: 1fr;
    }

    /* Information */
    .information-layout {
        flex-direction: column;
        align-items: flex-start;
    }

    /* Support */
    .support-box {
        flex-direction: column;
        align-items: flex-start;
        gap: 25px;
        padding: 40px 28px;
    }

    .support-content h2 {
        font-size: 29px;
    }

    .support-visual {
        align-self: center;
    }

    /* Footer */
    .footer-content {
        grid-template-columns: 1fr;
        gap: 35px;
    }

    .footer-bottom {
        flex-direction: column;
        gap: 8px;
    }
}

/* ==========================================
   SMALL MOBILE
========================================== */

@media (max-width: 400px) {
    .hero h1 {
        font-size: 33px;
    }

    .hero-actions {
        flex-direction: column;
    }

    .hero-actions a {
        width: 100%;
    }

    .hero-badge {
        font-size: 10px;
    }

    .hero-visual {
        min-height: 350px;
    }

    .dashboard-card {
        padding: 15px;
    }

    .mini-service {
        gap: 7px;
        padding: 9px 7px;
    }

    .mini-service span {
        font-size: 11px;
    }

    .section-heading h2 {
        font-size: 27px;
    }

    .support-content h2 {
        font-size: 26px;
    }
}
