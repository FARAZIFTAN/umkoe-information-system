/* =========================================
   ADMIN PDM
========================================= */

.admin-main {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: 38px 0 70px;
}

.admin-heading {
    margin-bottom: 26px;
}

.admin-heading h1 {
    margin: 12px 0 10px;
    color: var(--navy);
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 800;
    line-height: 1.2;
}

.admin-heading > p {
    max-width: 680px;
    color: var(--muted);
    line-height: 1.7;
}

.admin-demo-notice {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    align-items: center;
    padding: 15px 18px;
    margin-bottom: 24px;
    border: 1px solid #f1d48a;
    border-radius: 12px;
    background: #fffbeb;
    color: #78350f;
    font-size: 13px;
}

.admin-demo-notice strong {
    font-weight: 800;
}

.admin-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 28px;
}

.admin-stat-card {
    display: flex;
    align-items: center;
    gap: 15px;
    min-height: 112px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    box-shadow: 0 5px 18px rgba(20, 38, 80, 0.04);
}

.stat-icon {
    display: grid;
    flex: 0 0 46px;
    width: 46px;
    height: 46px;
    place-items: center;
    border-radius: 13px;
    font-size: 23px;
    font-weight: 800;
}

.stat-icon-blue {
    color: #244fc5;
    background: #eaf0ff;
}

.stat-icon-orange {
    color: #b45309;
    background: #fff1df;
}

.stat-icon-yellow {
    color: #92400e;
    background: #fef3c7;
}

.stat-icon-green {
    color: #15803d;
    background: #dcfce7;
}

.stat-label {
    display: block;
    margin-bottom: 5px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.5;
}

.admin-stat-card strong {
    color: var(--navy);
    font-size: 27px;
    font-weight: 800;
}

.admin-panel,
.admin-detail-panel {
    padding: 26px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
    box-shadow: 0 8px 28px rgba(20, 38, 80, 0.05);
}

.admin-panel-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 18px;
    margin-bottom: 24px;
}

.admin-section-label {
    color: var(--blue);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.1px;
}

.admin-panel-heading h2 {
    margin: 7px 0;
    color: var(--navy);
    font-size: 23px;
    font-weight: 800;
}

.admin-panel-heading p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
}

.admin-refresh-button,
.admin-close-button {
    padding: 11px 15px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: #fff;
    color: var(--navy);
    font: inherit;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: 0.2s ease;
}

.admin-refresh-button:hover,
.admin-close-button:hover {
    border-color: var(--blue);
    color: var(--blue);
    background: var(--blue-light);
}

.admin-toolbar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 230px;
    gap: 16px;
    margin-bottom: 20px;
}

.admin-search label,
.admin-filter label,
.admin-form-group label {
    display: block;
    margin-bottom: 8px;
    color: var(--navy);
    font-size: 12px;
    font-weight: 700;
}

.admin-search input,
.admin-filter select,
.admin-form-group select,
.admin-form-group textarea {
    width: 100%;
    min-height: 45px;
    padding: 11px 13px;
    border: 1px solid var(--border);
    border-radius: 9px;
    outline: none;
    background: #fff;
    color: var(--text);
    font: inherit;
    font-size: 13px;
    transition: border-color 0.2s, box-shadow 0.2s;
}

.admin-search input:focus,
.admin-filter select:focus,
.admin-form-group select:focus,
.admin-form-group textarea:focus {
    border-color: var(--blue);
    box-shadow: 0 0 0 3px rgba(36, 79, 197, 0.1);
}

.admin-table-wrapper {
    width: 100%;
    overflow-x: auto;
}

.admin-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
}

.admin-table th {
    padding: 14px 13px;
    border-bottom: 1px solid var(--border);
    background: #f7f9fd;
    color: #526078;
    font-size: 11px;
    font-weight: 800;
    white-space: nowrap;
}

.admin-table td {
    padding: 15px 13px;
    border-bottom: 1px solid #edf0f5;
    color: var(--text);
    font-size: 12px;
    vertical-align: middle;
}

.admin-table tbody tr:hover {
    background: #fafbff;
}

.admin-student-name {
    display: block;
    color: var(--navy);
    font-size: 12px;
    font-weight: 800;
}

.admin-student-nim {
    display: block;
    margin-top: 4px;
    color: var(--muted);
    font-size: 11px;
}

.admin-code {
    color: var(--blue);
    font-size: 11px;
    font-weight: 800;
    white-space: nowrap;
}

.admin-status {
    display: inline-flex;
    align-items: center;
    padding: 6px 9px;
    border-radius: 20px;
    font-size: 10px;
    font-weight: 800;
    white-space: nowrap;
}

.admin-status.is-review {
    color: #1d4ed8;
    background: #dbeafe;
}

.admin-status.is-revision {
    color: #92400e;
    background: #fef3c7;
}

.admin-status.is-approved {
    color: #166534;
    background: #dcfce7;
}

.admin-status.is-rejected {
    color: #991b1b;
    background: #fee2e2;
}

.admin-detail-button {
    padding: 8px 12px;
    border: 0;
    border-radius: 7px;
    background: var(--blue-light);
    color: var(--blue);
    font: inherit;
    font-size: 11px;
    font-weight: 800;
    cursor: pointer;
    white-space: nowrap;
}

.admin-detail-button:hover {
    background: var(--blue);
    color: #fff;
}

.admin-table-empty {
    padding: 35px 15px !important;
    color: var(--muted) !important;
    text-align: center;
}

.admin-table-footer {
    padding-top: 16px;
    color: var(--muted);
    font-size: 11px;
}

.admin-detail-panel {
    margin-top: 28px;
    scroll-margin-top: 25px;
}

.detail-code-box {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
    padding: 15px 18px;
    margin-bottom: 22px;
    border: 1px solid #dce5ff;
    border-radius: 11px;
    background: #f3f6ff;
}

.detail-code-box span {
    color: var(--muted);
    font-size: 12px;
}

.detail-code-box strong {
    color: var(--blue);
    font-size: 13px;
}

.admin-detail-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
}

.admin-detail-item {
    padding: 15px;
    border: 1px solid #e9edf4;
    border-radius: 10px;
    background: #fcfdff;
}

.admin-detail-item span {
    display: block;
    margin-bottom: 7px;
    color: var(--muted);
    font-size: 11px;
}

.admin-detail-item strong {
    color: var(--navy);
    font-size: 13px;
    overflow-wrap: anywhere;
}

.admin-document-section,
.admin-review-form,
.admin-history-section {
    margin-top: 26px;
    padding-top: 23px;
    border-top: 1px solid var(--border);
}

.admin-document-section h3,
.admin-review-form h3,
.admin-history-section h3 {
    margin-bottom: 16px;
    color: var(--navy);
    font-size: 16px;
    font-weight: 800;
}

.admin-document-list {
    display: grid;
    gap: 9px;
}

.admin-document-item {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 12px;
    border: 1px solid #e9edf4;
    border-radius: 9px;
    background: #fcfdff;
    font-size: 12px;
    overflow-wrap: anywhere;
}

.admin-document-icon {
    display: grid;
    flex: 0 0 34px;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 8px;
    background: var(--blue-light);
    color: var(--blue);
    font-weight: 800;
}

.admin-document-note {
    margin-top: 10px;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.6;
}

.admin-review-form {
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #fafbfe;
}

.admin-form-group {
    margin-bottom: 18px;
}

.admin-form-group textarea {
    min-height: 105px;
    resize: vertical;
}

.admin-form-group small {
    display: block;
    margin-top: 7px;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.6;
}

.admin-form-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
}

.admin-save-button {
    padding: 12px 19px;
    border: 0;
    border-radius: 9px;
    background: var(--blue);
    color: #fff;
    font: inherit;
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
    transition: 0.2s ease;
}

.admin-save-button:hover {
    background: var(--navy);
}

#reviewMessage {
    color: var(--success);
    font-size: 12px;
    font-weight: 700;
}

.admin-history {
    display: grid;
    gap: 0;
}

.admin-history-item {
    position: relative;
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr);
    gap: 12px;
    padding-bottom: 20px;
}

.admin-history-marker {
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border-radius: 50%;
    background: var(--blue-light);
    color: var(--blue);
    font-size: 11px;
    font-weight: 800;
}

.admin-history-content strong {
    display: block;
    margin-bottom: 5px;
    color: var(--navy);
    font-size: 12px;
}

.admin-history-content p {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.6;
    overflow-wrap: anywhere;
}

.admin-history-content time {
    display: block;
    margin-top: 6px;
    color: #8993a5;
    font-size: 10px;
}

@media (max-width: 900px) {
    .admin-stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .admin-table {
        min-width: 780px;
    }
}

@media (max-width: 600px) {
    .admin-main {
        width: min(100% - 26px, 1180px);
        padding-top: 25px;
    }

    .admin-stats {
        gap: 10px;
    }

    .admin-stat-card {
        min-height: 95px;
        gap: 10px;
        padding: 13px;
    }

    .stat-icon {
        flex-basis: 36px;
        width: 36px;
        height: 36px;
        font-size: 18px;
    }

    .admin-stat-card strong {
        font-size: 22px;
    }

    .stat-label {
        font-size: 10px;
    }

    .admin-panel,
    .admin-detail-panel {
        padding: 17px;
    }

    .admin-panel-heading {
        flex-direction: column;
    }

    .admin-toolbar {
        grid-template-columns: 1fr;
    }

    .admin-detail-grid {
        grid-template-columns: 1fr;
    }

    .admin-review-form {
        padding: 15px;
    }
}
