/* ==========================================
   PUSDATIN UMKOE - MODERN HOMEPAGE
========================================== */

:root {
    /* IDENTITAS UTAMA */
    --navy: #142650;
    --navy-dark: #0c1938;

    /* WARNA INTERAKSI */
    --blue: #244fc5;
    --blue-light: #eaf0ff;

    /* WARNA AKSEN */
    --yellow: #ffc83d;

    /* WARNA DASAR */
    --white: #ffffff;
    --background: #f5f7fc;
    --surface: #ffffff;

    /* WARNA TEKS */
    --text: #172033;
    --muted: #4b5563;

    /* PEMBATAS DAN EFEK */
    --border: #d6deeb;
    --shadow: 0 12px 32px rgba(20, 38, 80, 0.10);

    /* STATUS */
    --success: #15803d;
    --success-light: #dcfce7;

    --danger: #b91c1c;
    --danger-light: #fee2e2;

    --warning: #92400e;
    --warning-light: #fef3c7;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Plus Jakarta Sans", sans-serif;
    color: var(--text);
    background: var(--background);
    line-height: 1.7;
}

a {
    text-decoration: none;
    color: inherit;
}

ul {
    list-style: none;
}

svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
}

.container {
    width: min(1200px, 90%);
    margin-inline: auto;
}

/* ==========================================
   NAVBAR
========================================== */

.site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--border);
}

.navbar {
    min-height: 84px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
}

.brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    flex-shrink: 0;
}

.brand-icon {
    display: grid;
    place-items: center;
    width: 45px;
    height: 45px;
    border-radius: 13px;
    background: var(--navy);
    color: var(--yellow);
    font-size: 25px;
    font-weight: 800;
}

.brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
}

.brand-text strong {
    font-size: 19px;
    font-weight: 800;
    color: var(--navy);
    letter-spacing: -0.5px;
}

.brand-text small {
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.7px;
    color: var(--muted);
}

.nav-menu {
    display: flex;
    align-items: center;
    gap: 29px;
}

.nav-menu a {
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
    transition: 0.25s;
}

.nav-menu a:hover,
.nav-menu a.active {
    color: var(--blue);
}

.nav-admin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 11px 17px;
    border-radius: 9px;
    background: var(--navy);
    color: var(--white);
    font-size: 12px;
    font-weight: 700;
    transition: 0.25s;
}

.nav-admin svg {
    width: 17px;
    height: 17px;
}

.nav-admin:hover {
    background: var(--blue);
    transform: translateY(-2px);
}

/* ==========================================
   HERO
========================================== */

.hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(115deg, #101d40 0%, #1b3473 58%, #294c9e 100%);
    color: var(--white);
}

.hero-layout {
    position: relative;
    z-index: 2;
    min-height: 625px;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 55px;
    padding-top: 75px;
    padding-bottom: 75px;
}

.hero-shape {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
}

.hero-shape-one {
    width: 520px;
    height: 520px;
    top: -280px;
    right: -100px;
    border: 1px solid rgba(255,255,255,0.1);
    box-shadow:
        0 0 0 55px rgba(255,255,255,0.025),
        0 0 0 110px rgba(255,255,255,0.025);
}

.hero-shape-two {
    width: 250px;
    height: 250px;
    bottom: -180px;
    left: 30%;
    background: rgba(255,255,255,0.04);
}

.hero-content {
    max-width: 620px;
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 14px;
    margin-bottom: 26px;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 30px;
    background: rgba(255,255,255,0.07);
    color: #e1eaff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.1px;
}

.status-dot,
.footer-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #51d6a4;
    box-shadow: 0 0 0 4px rgba(81,214,164,0.13);
}

.hero h1 {
    font-size: clamp(38px, 4.3vw, 57px);
    line-height: 1.18;
    letter-spacing: -2.4px;
    font-weight: 800;
    margin-bottom: 22px;
}

.hero h1 span {
    color: var(--yellow);
}

.hero-description {
    max-width: 540px;
    color: #c8d5ef;
    font-size: 14px;
    line-height: 1.9;
    margin-bottom: 30px;
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 13px;
}

.btn-primary,
.btn-outline {
    min-height: 48px;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    padding: 0 21px;
    border-radius: 9px;
    font-size: 12px;
    font-weight: 700;
    transition: 0.25s;
}

.btn-primary {
    background: var(--yellow);
    color: var(--navy);
}

.btn-primary svg {
    width: 17px;
    height: 17px;
}

.btn-primary:hover {
    background: #ffda72;
    transform: translateY(-3px);
}

.btn-outline {
    border: 1px solid rgba(255,255,255,0.35);
    color: var(--white);
}

.btn-outline:hover {
    background: var(--white);
    color: var(--navy);
}

.hero-note {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 35px;
    color: #aebfdf;
    font-size: 11px;
}

.note-icon {
    color: var(--yellow);
    font-size: 17px;
}

/* ==========================================
   HERO DASHBOARD VISUAL
========================================== */

.hero-visual {
    position: relative;
    min-height: 430px;
    display: grid;
    place-items: center;
}

.visual-glow {
    position: absolute;
    width: 330px;
    height: 330px;
    background: rgba(101, 135, 231, 0.22);
    border-radius: 50%;
    filter: blur(50px);
}

.dashboard-card {
    position: relative;
    z-index: 2;
    width: min(100%, 435px);
    padding: 25px;
    border: 1px solid rgba(255,255,255,0.65);
    border-radius: 19px;
    background: rgba(255,255,255,0.97);
    color: var(--text);
    box-shadow: 0 35px 80px rgba(0,0,0,0.25);
    transform: rotate(1deg);
}

.dashboard-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 23px;
}

.dashboard-caption {
    display: block;
    color: var(--blue);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 1.4px;
    margin-bottom: 4px;
}

.dashboard-top h3 {
    font-size: 19px;
    color: var(--navy);
}

.dashboard-menu {
    color: #64748b;
    letter-spacing: 2px;
}

.dashboard-welcome {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 18px;
    border-radius: 12px;
    background: #f0f4ff;
}

.dashboard-welcome small {
    color: var(--muted);
    font-size: 9px;
}

.dashboard-welcome h4 {
    color: var(--navy);
    font-size: 13px;
    margin: 3px 0;
}

.dashboard-welcome p {
    color: var(--muted);
    font-size: 8px;
}

.welcome-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 12px;
    background: var(--navy);
    color: var(--yellow);
}

.welcome-icon svg {
    width: 25px;
    height: 25px;
}

.dashboard-divider {
    height: 1px;
    margin: 22px 0;
    background: var(--border);
}

.dashboard-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
}

.dashboard-label strong {
    font-size: 11px;
    color: var(--navy);
}

.dashboard-label span {
    color: var(--muted);
    font-size: 8px;
}

.dashboard-services {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 11px;
}

.mini-service {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 10px;
    border: 1px solid var(--border);
    border-radius: 10px;
}

.mini-service span {
    font-size: 9px;
    font-weight: 700;
    color: var(--text);
}

.mini-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
}

.mini-icon svg {
    width: 18px;
    height: 18px;
}

.mini-blue {
    color: #315bd6;
    background: #e8efff;
}

.mini-yellow {
    color: #b7810c;
    background: #fff4d8;
}

.mini-purple {
    color: #8054c7;
    background: #f1eaff;
}

.mini-green {
    color: #15936e;
    background: #e1f8ef;
}

.dashboard-footer {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 20px;
    padding-top: 15px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 9px;
}

.dashboard-footer .footer-indicator {
    width: 7px;
    height: 7px;
    box-shadow: none;
}

.floating-card {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 15px;
    border: 1px solid rgba(255,255,255,0.6);
    border-radius: 12px;
    background: var(--white);
    color: var(--navy);
    box-shadow: 0 15px 35px rgba(0,0,0,0.16);
}

.floating-card strong,
.floating-card small {
    display: block;
}

.floating-card strong {
    font-size: 10px;
}

.floating-card small {
    color: var(--muted);
    font-size: 8px;
}

.floating-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: #fff3d0;
    color: #bd850b;
}

.floating-card-top {
    top: 30px;
    right: -12px;
}

.floating-card-bottom {
    bottom: 30px;
    left: -20px;
}

.floating-check {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #e0f7ed;
    color: #15936e;
    font-weight: 800;
}

/* ==========================================
   QUICK INFORMATION
========================================== */

.quick-info {
    position: relative;
    z-index: 5;
    background: var(--white);
    border-bottom: 1px solid var(--border);
}

.quick-info-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 27px 0;
}

.quick-info-item {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 5px 28px;
    border-right: 1px solid var(--border);
}

.quick-info-item:first-child {
    padding-left: 0;
}

.quick-info-item:last-child {
    border-right: none;
}

.quick-info-number {
    color: #a2b3d8;
    font-size: 24px;
    font-weight: 800;
}

.quick-info-item strong,
.quick-info-item small {
    display: block;
}

.quick-info-item strong {
    color: var(--navy);
    font-size: 11px;
}

.quick-info-item small {
    color: var(--muted);
    font-size: 9px;
}

/* ==========================================
   SECTION HEADING
========================================== */

.section {
    padding: 95px 0;
}

.section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 35px;
    margin-bottom: 42px;
}

.section-eyebrow {
    display: block;
    margin-bottom: 12px;
    color: var(--blue);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.8px;
}

.section-heading h2 {
    color: var(--navy);
    font-size: clamp(28px, 3.2vw, 38px);
    line-height: 1.3;
    letter-spacing: -1.3px;
    font-weight: 800;
}

.section-heading > p {
    max-width: 400px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.9;
    padding-bottom: 5px;
}

/* ==========================================
   SERVICE CARDS
========================================== */

.services-section {
    background: var(--background);
}

.service-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
}

.service-card {
    position: relative;
    padding: 25px 22px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--white);
    transition: 0.3s ease;
}

.service-card:hover {
    transform: translateY(-7px);
    border-color: #cad6f3;
    box-shadow: var(--shadow);
}

.service-icon {
    display: grid;
    place-items: center;
    width: 49px;
    height: 49px;
    margin-bottom: 22px;
    border-radius: 13px;
}

.service-icon svg {
    width: 24px;
    height: 24px;
}

.icon-blue {
    color: #315bd6;
    background: #e9efff;
}

.icon-purple {
    color: #8054c7;
    background: #f1eaff;
}

.icon-orange {
    color: #c17d15;
    background: #fff2dc;
}

.icon-green {
    color: #16966e;
    background: #e2f8ef;
}

.service-category {
    display: block;
    color: #526078;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 1px;
    margin-bottom: 10px;
}

.service-card h3 {
    min-height: 48px;
    color: var(--navy);
    font-size: 14px;
    line-height: 1.55;
    margin-bottom: 10px;
}

.service-card p {
    min-height: 78px;
    color: var(--muted);
    font-size: 10px;
    line-height: 1.9;
    margin-bottom: 20px;
}

.service-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--blue);
    font-size: 10px;
    font-weight: 800;
}

.service-link span {
    font-size: 16px;
    transition: transform 0.2s;
}

.service-link:hover span {
    transform: translateX(5px);
}

/* ==========================================
   INFRASTRUCTURE
========================================== */

.infrastructure-section {
    background: var(--white);
}

.infrastructure-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
}

.infrastructure-card {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 23px 20px;
    border: 1px solid var(--border);
    border-radius: 13px;
    background: var(--white);
    transition: 0.3s;
}

.infrastructure-card:hover {
    border-color: #bdcbed;
    box-shadow: var(--shadow);
    transform: translateY(-4px);
}

.infra-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 12px;
    background: var(--blue-light);
    color: var(--blue);
}

.infra-icon svg {
    width: 23px;
    height: 23px;
}

.infrastructure-card h3 {
    color: var(--navy);
    font-size: 11px;
    margin-bottom: 4px;
}

.infrastructure-card p {
    color: var(--muted);
    font-size: 9px;
    line-height: 1.7;
}

.infra-arrow {
    margin-left: auto;
    color: #8ba0c7;
    font-size: 18px;
}

/* ==========================================
   INFORMATION
========================================== */

.information-section {
    padding: 40px 0;
    background: #edf2ff;
}

.information-layout {
    display: flex;
    align-items: center;
    gap: 25px;
}

.information-icon {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    flex-shrink: 0;
    border-radius: 15px;
    background: var(--white);
    color: var(--blue);
}

.information-icon svg {
    width: 28px;
    height: 28px;
}

.information-text {
    flex: 1;
}

.information-text .section-eyebrow {
    margin-bottom: 5px;
}

.information-text h2 {
    color: var(--navy);
    font-size: 19px;
    margin-bottom: 4px;
}

.information-text p {
    color: var(--muted);
    font-size: 10px;
}

.information-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--blue);
    font-size: 11px;
    font-weight: 800;
}

/* ==========================================
   SUPPORT
========================================== */

.support-section {
    padding: 85px 0;
    background: var(--background);
}

.support-box {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 310px;
    padding: 55px 65px;
    border-radius: 20px;
    background: linear-gradient(115deg, #142650, #284c9b);
    color: var(--white);
}

.support-content {
    position: relative;
    z-index: 2;
    max-width: 570px;
}

.support-label {
    color: var(--yellow);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.7px;
}

.support-content h2 {
    margin: 12px 0;
    font-size: 32px;
    line-height: 1.3;
    letter-spacing: -1px;
}

.support-content p {
    max-width: 490px;
    margin-bottom: 24px;
    color: #cbd7ef;
    font-size: 11px;
    line-height: 1.9;
}

.support-button {
    display: inline-flex;
    align-items: center;
    gap: 15px;
    padding: 12px 19px;
    border-radius: 8px;
    background: var(--yellow);
    color: var(--navy);
    font-size: 11px;
    font-weight: 800;
    transition: 0.25s;
}

.support-button:hover {
    background: var(--white);
    transform: translateY(-3px);
}

.support-visual {
    position: relative;
    display: grid;
    place-items: center;
    width: 230px;
    height: 230px;
    flex-shrink: 0;
}

.support-circle {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 145px;
    height: 145px;
    border: 1px solid rgba(255,255,255,0.35);
    border-radius: 50%;
    background: rgba(255,255,255,0.1);
    color: var(--yellow);
}

.support-circle svg {
    width: 70px;
    height: 70px;
    stroke-width: 1.3;
}

.support-decoration {
    position: absolute;
    width: 210px;
    height: 210px;
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 50%;
    box-shadow: 0 0 0 25px rgba(255,255,255,0.04);
}

/* ==========================================
   FOOTER
========================================== */

.footer {
    padding-top: 65px;
    background: var(--navy-dark);
    color: #c6d1e7;
}

.footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 70px;
    padding-bottom: 50px;
}

.footer-logo .brand-icon {
    background: var(--white);
    color: var(--navy);
}

.footer-logo .brand-text strong {
    color: var(--white);
}

.footer-logo .brand-text small {
    color: #a9b8d5;
}

.footer-brand > p {
    max-width: 320px;
    margin-top: 18px;
    color: #a9b8d5;
    font-size: 10px;
    line-height: 1.9;
}

.footer-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
}

.footer-links strong {
    margin-bottom: 5px;
    color: var(--white);
    font-size: 12px;
}

.footer-links a {
    color: #a9b8d5;
    font-size: 10px;
    transition: 0.2s;
}

.footer-links a:hover {
    color: var(--yellow);
}

.footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding: 20px 0;
    border-top: 1px solid rgba(255,255,255,0.2);
    color: #cbd5e1;
    font-size: 12px;
}

/* ANCHOR OFFSET */

section[id] {
    scroll-margin-top: 100px;
}

/* ==========================================
   TYPOGRAPHY IMPROVEMENT
   ========================================== */

/* Teks dasar */
body {
    font-size: 16px;
}

/* Navbar */
.brand-text small {
    font-size: 10px;
}

.nav-menu a {
    font-size: 15px;
}

.nav-admin {
    font-size: 14px;
}

/* Hero */
.hero-badge {
    font-size: 12px;
}

.hero-description {
    font-size: 16px;
}

.btn-primary,
.btn-outline {
    font-size: 14px;
}

.hero-note {
    font-size: 13px;
}

/* Dashboard dekoratif */
.dashboard-caption {
    font-size: 10px;
}

.dashboard-welcome small {
